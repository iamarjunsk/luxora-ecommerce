# Environment Variables Template
# Copy this to .env.production and fill in actual values

# Database - Use PostgreSQL for production
DATABASE_URL="postgresql://username:password@localhost:5432/luxora_production"

# JWT Secret - Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secure-random-jwt-secret-minimum-32-characters"

# Razorpay Payment Gateway - Use PRODUCTION credentials
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# Application URL
NUXT_PUBLIC_BASE_URL="https://yourdomain.com"

# File Upload Directory
UPLOAD_DIR="./public/uploads"

# Optional: Cloud Storage (Uncomment and configure if using)
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# AWS_BUCKET="your-bucket-name"
# AWS_REGION="us-east-1"
